{
  "name": "sub2api-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vue-tsc -b && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --cache --fix",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --cache",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@airwallex/components-sdk": "^1.30.2",
    "@fontsource-variable/fraunces": "^5.0.0",
    "@fontsource-variable/inter": "^5.0.0",
    "@stripe/stripe-js": "^9.0.1",
    "@tanstack/vue-virtual": "^3.13.23",
    "@vueuse/core": "^10.7.0",
    "axios": "^1.18.1",
    "cap-widget": "^0.1.56",
    "chart.js": "^4.4.1",
    "dompurify": "^3.4.14",
    "driver.js": "^1.4.0",
    "file-saver": "^2.0.5",
    "gsap": "^3.15.0",
    "marked": "^17.0.1",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "vue": "^3.4.0",
    "vue-chartjs": "^5.3.0",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.2.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@intlify/message-compiler": "9.14.5",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/mdx": "^2.0.13",
    "@types/node": "^20.10.5",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.25.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.12",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.0",
    "vite": "^5.0.10",
    "vite-plugin-checker": "^0.9.1",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  },
  "pnpm": {
    "_comment": "pnpm 9 (used by CI) reads overrides from here; pnpm 11 (used locally) reads them from pnpm-workspace.yaml. Keep both lists identical.",
    "overrides": {
      "js-cookie": "3.0.7",
      "form-data@<4.0.6": ">=4.0.6",
      "mermaid@11.14.0": "11.16.0",
      "postcss": "8.5.22",
      "uuid@11.1.0": "11.1.1",
      "uuid@13.0.0": "13.0.1",
      "yaml@1.10.2": "1.10.3",
      "minimatch@<3.1.4": ">=3.1.4 <4",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7 <10",
      "brace-expansion@<1.1.16": ">=1.1.16 <2",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2 <3",
      "picomatch@<2.3.2": ">=2.3.2 <3",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4 <5",
      "flatted@<3.4.2": ">=3.4.2 <4",
      "js-yaml@>=4.0.0 <4.3.0": ">=4.3.0 <5",
      "lodash@<4.17.24": ">=4.17.24",
      "ws@<8.21.0": ">=8.21.0 <9",
      "ajv@>=6.0.0 <6.14.0": ">=6.14.0 <7",
      "rollup@<4.59.0": ">=4.59.0 <5",
      "dompurify@<3.4.14": ">=3.4.14"
    }
  }
}
