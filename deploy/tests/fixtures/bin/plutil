#!/bin/bash

set -eu

[[ "${1-}" == "-extract" ]] || exit 1
path=${2-}
json=$(</dev/stdin)

case "${path}" in
    0.configuration.labels)
        [[ "${json}" =~ \"org.sub2api.stack\":\"([^\"]+)\" ]] || exit 1
        printf '{"org.sub2api.stack":"%s"}\n' "${BASH_REMATCH[1]}"
        ;;
    0.status.networks.0.ipv4Address)
        [[ "${json}" =~ \"ipv4Address\":\"([^\"]+)\" ]] || exit 1
        printf '%s\n' "${BASH_REMATCH[1]}"
        ;;
    *)
        exit 1
        ;;
esac
